{
  "name": "@kova/shared",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser-safe": {
      "types": "./dist/browser-safe.d.ts",
      "import": "./dist/browser-safe.mjs",
      "require": "./dist/browser-safe.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser-safe.ts --format esm,cjs --dts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0"
  }
}
